{
  "schema": 1,
  "name": "agent-playbook",
  "version": "2.0.0",
  "roles": {
    "lead": {
      "stamp": "ROLE: lead",
      "instances": 1,
      "bundle": [
        "roles/lead/ROLE.md",
        "roles/lead/skills/clarifying.md",
        "roles/lead/skills/writing-spec.md",
        "roles/lead/skills/writing-plan.md",
        "roles/lead/skills/briefing.md",
        "shared/verification.md",
        "shared/reporting.md"
      ]
    },
    "executor": {
      "stamp": "ROLE: executor",
      "instances": 1,
      "bundle": [
        "roles/executor/ROLE.md",
        "roles/executor/skills/following-plan.md",
        "roles/executor/skills/tests-first.md",
        "roles/executor/skills/handling-review.md",
        "shared/verification.md",
        "shared/debugging.md",
        "shared/reporting.md"
      ]
    },
    "reviewer": {
      "stamp": "ROLE: reviewer",
      "instances": 2,
      "bundle": [
        "roles/reviewer/ROLE.md",
        "roles/reviewer/skills/reviewing.md",
        "shared/verification.md",
        "shared/reporting.md"
      ]
    },
    "scout": {
      "stamp": "ROLE: scout",
      "instances": 1,
      "bundle": [
        "roles/scout/ROLE.md",
        "roles/scout/skills/exploring.md",
        "shared/verification.md",
        "shared/debugging.md",
        "shared/reporting.md"
      ]
    },
    "researcher": {
      "stamp": "ROLE: researcher",
      "instances": 1,
      "bundle": [
        "roles/researcher/ROLE.md",
        "roles/researcher/skills/researching.md",
        "shared/verification.md",
        "shared/reporting.md"
      ]
    },
    "arbiter": {
      "stamp": "ROLE: arbiter",
      "instances": 1,
      "bundle": [
        "roles/arbiter/ROLE.md",
        "shared/verification.md",
        "shared/debugging.md",
        "shared/reporting.md"
      ]
    }
  },
  "model_rules": [
    {"roles": ["reviewer", "arbiter"], "must_differ_from": "executor"}
  ],
  "model_sets": {
    "codex-only": "models/codex-only.json",
    "claude-only": "models/claude-only.json",
    "codex+claude": "models/codex+claude.json"
  }
}
